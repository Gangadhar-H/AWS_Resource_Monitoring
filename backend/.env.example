# --- Provider: 'aws' (real account, needs keys below) or 'demo' (sample data, no keys needed) ---
CLOUD_PROVIDER=demo

# --- Cloud account (read-only IAM user recommended) ---
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
# AWS_PROFILE=            # optional: use a named profile instead of keys

# --- Rules ---
CPU_THRESHOLD_PERCENT=5
LOOKBACK_DAYS=14
UNDERUTILIZED_SAVINGS_FACTOR=0.5

# --- Storage (leave MONGO_URI empty to use data/scans.json) ---
MONGO_URI=
MONGO_DB=cloud_cost_monitor

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
